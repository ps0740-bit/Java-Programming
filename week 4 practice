public class Solution {
    public boolean containsDuplicate(int[] nums) {
        // Outer loop iterates through each element at position i
        for (int i = 0; i < nums.length; i++) {
            // Inner loop compares with every subsequent element at position j
            for (int j = i + 1; j < nums.length; j++) {
                // Return true right away if two distinct positions hold the exact same value
                if (nums[i] == nums[j]) {
                    return true;
                }
            }
        }
        // Return false if no duplicate pair is found after checking all pairs
        return false;
    }
}
