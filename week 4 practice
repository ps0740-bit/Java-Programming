public class Solution {
    public int[] rotateArray(int[] nums, int k) {
        int n = nums.length;
        if (n == 0) {
            return nums;
        }

        // Reduce k so that unnecessary full rotations are avoided
        k = k % n; //

        // Create a new array of the same size
        int[] rotated = new int[n]; //

        // Calculate each element's new position after rotation
        for (int i = 0; i < n; i++) {
            rotated[(i + k) % n] = nums[i]; //
        }

        return rotated; //
    }
}
