public class Solution {
    public static String findDuplicatePick(String[] playerNames) {
        // Outer loop iterates through each player name up to the second to last[cite: 2]
        for (int i = 0; i < playerNames.length; i++) {
            // Inner loop compares the current player against all subsequent players[cite: 2]
            for (int j = i + 1; j < playerNames.length; j++) {
                // Case-sensitive comparison using .equals()[cite: 2]
                if (playerNames[i].equals(playerNames[j])) {
                    return "Duplicate Found: " + playerNames[i];
                }
            }
        }
        
        // Return clear message if no duplicates are found[cite: 2]
        return "No Duplicates Found";
    }

    public static void main(String[] args) {
        // Example 1: Duplicate exists[cite: 2]
        String[] lineup1 = {"Kohli", "Bumrah", "Kohli", "Rohit"};
        System.out.println(findDuplicatePick(lineup1)); 
        // Output: "Duplicate Found: Kohli"[cite: 2]

        // Example 2: No duplicates[cite: 2]
        String[] lineup2 = {"Kohli", "Bumrah", "Rohit"};
        System.out.println(findDuplicatePick(lineup2)); 
        // Output: "No Duplicates Found"[cite: 2]
    }
}
