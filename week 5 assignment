public class Solution {

    /**
     * Helper method that calculates the average of a single row (match).
     * 
     * @param row Array representing runs in each over for one match
     * @return The calculated average as a double
     */
    private static double rowAverage(int[] row) {
        int sum = 0;
        for (int runs : row) {
            sum += runs;
        }
        // Double casting ensures floating-point division
        return (double) sum / row.length;
    }

    /**
     * Classifies each match as "Power Surge" or "Normal" based on average runs[cite: 4].
     * 
     * @param runsPerOver 2D array of runs per over for each match[cite: 4]
     * @param threshold   Average runs threshold to be considered a Power Surge[cite: 4]
     * @return Formatted classification string for all matches[cite: 4]
     */
    public static String classifyMatches(int[][] runsPerOver, int threshold) {
        StringBuilder result = new StringBuilder();

        for (int i = 0; i < runsPerOver.length; i++) {
            // Call helper method to get the average for the current row[cite: 4]
            double avg = rowAverage(runsPerOver[i]);

            // Determine status based on threshold comparison[cite: 4]
            String status = (avg >= threshold) ? "Power Surge" : "Normal";

            // Format output[cite: 4]
            result.append("Match ").append(i).append(": ").append(status);

            // Append separator if not the last item[cite: 4]
            if (i < runsPerOver.length - 1) {
                result.append(" | ");
            }
        }

        return result.toString();
    }

    public static void main(String[] args) {
        // Example test case[cite: 4]
        int[][] runsPerOver = {
            {4, 6, 8},
            {10, 12, 14},
            {2, 3, 1}
        };
        int threshold = 8;

        // Output: "Match 0: Normal | Match 1: Power Surge | Match 2: Normal"[cite: 4]
        System.out.println(classifyMatches(runsPerOver, threshold));
    }
}
