public class Solution {

    /**
     * Finds the minimum, maximum, and spread (max - min) in a single pass.
     * 
     * @param scores Array of integer scores (length >= 2)
     * @return Formatted string containing Min, Max, and Spread
     */
    public static String findMinMaxSpread(int[] scores) {
        // Initialize min and max with the first element of the array
        int min = scores[0];
        int max = scores[0];

        // Single pass starting from the second element
        for (int i = 1; i < scores.length; i++) {
            if (scores[i] < min) {
                min = scores[i];
            }
            if (scores[i] > max) {
                max = scores[i];
            }
        }

        // Calculate spread[cite: 3]
        int spread = max - min;

        // Return the formatted result matching the required output format[cite: 3]
        return "Min: " + min + " | Max: " + max + " | Spread: " + spread;
    }

    public static void main(String[] args) {
        // Example test case[cite: 3]
        int[] scores = {45, 82, 79, 90, 33, 90, 61};
        
        // Output: "Min: 33 | Max: 90 | Spread: 57"[cite: 3]
        System.out.println(findMinMaxSpread(scores));
    }
}
