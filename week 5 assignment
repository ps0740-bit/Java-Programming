public static void applyMultipliers(double[] playerScores, int captainIndex, int viceCaptainIndex) {
        // Multiply captain's score by 2.0[cite: 1]
        playerScores[captainIndex] *= 2.0;

        // Multiply vice-captain's score by 1.5[cite: 1]
        playerScores[viceCaptainIndex] *= 1.5;
    }

    public static void main(String[] args) {
        // Example usage based on problem description[cite: 1]
        double[] scores = {40, 55, 30, 62};
        applyMultipliers(scores, 1, 3);
        
        // Output: [40.0, 110.0, 30.0, 93.0][cite: 1]
        System.out.println(java.util.Arrays.toString(scores));
    }
}
