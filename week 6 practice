class Student {
    // Instance fields unique to each student
    String name;
    double attendance;

    // Static fields shared across all student instances
    static String collegeName = "SRM Institute of Science and Technology";
    static int studentCount = 0;

    // Constructor incrementing static counter on instantiation
    public Student(String name, double attendance) {
        this.name = name;
        this.attendance = attendance;
        studentCount++;
    }

    // Static method printing class-level information
    public static void printCollegeInfo() {
        System.out.println(collegeName);
        System.out.println("Students created: " + studentCount);
    }
}

public class Main {
    public static void main(String[] args) {
        // Instantiate two Student objects
        Student s1 = new Student("Ravi", 85.5);
        Student s2 = new Student("Anitha", 92.0);

        // Call printCollegeInfo via class name
        Student.printCollegeInfo();
    }
}
