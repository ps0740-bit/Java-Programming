import java.io.FileReader;
import java.io.IOException;
import java.util.Scanner;

public class JavaStringAndExceptionPractice {

    public static void main(String[] args) {
        Scanner inputScanner = new Scanner(System.in);

        demonstrateStringCreation();
        demonstrateEscapeSequences();
        
        String userInputText = captureUserInput(inputScanner);
        
        processStringArray();
        analyzeAndFormatString(userInputText);
        displayAsciiCodes(userInputText);
        handleUncheckedException(userInputText);
        handleCheckedException();

        inputScanner.close();
    }

    public static void demonstrateStringCreation() {
        String literalString = "Hello, Java!";
        String objectString = new String("Welcome to Practice Problems.");

        System.out.println("Literal String: " + literalString);
        System.out.println("Object String: " + objectString);
    }

    public static void demonstrateEscapeSequences() {
        String escapedText = "Learning \"Java Strings\"\n\t* Concept 1\n\t* Concept 2";
        System.out.println(escapedText);
    }

    public static String captureUserInput(Scanner scanner) {
        System.out.print("Enter a phrase: ");
        return scanner.nextLine();
    }

    public static void processStringArray() {
        String[] languagesArray = {"Java", "Python", "C++"};
        for (String language : languagesArray) {
            System.out.println("Language: " + language);
        }
    }

    public static void analyzeAndFormatString(String textToAnalyze) {
        System.out.println("Original: " + textToAnalyze);
        System.out.println("Length: " + textToAnalyze.length());
        System.out.println("Uppercase: " + textToAnalyze.toUpperCase());
        System.out.println("Trimmed: " + textToAnalyze.trim());
    }

    public static void displayAsciiCodes(String textSource) {
        for (int i = 0; i < textSource.length(); i++) {
            char ch = textSource.charAt(i);
            System.out.println("Char: '" + ch + "' -> ASCII: " + (int) ch);
        }
    }

    public static void handleUncheckedException(String textSource) {
        try {
            char invalidChar = textSource.charAt(textSource.length() + 5);
            System.out.println("Char: " + invalidChar);
        } catch (StringIndexOutOfBoundsException exception) {
            System.err.println("Unchecked Exception Caught: Invalid String Index.");
            System.err.println("Details: " + exception.getMessage());
        }
    }

    public static void handleCheckedException() {
        String filePath = "non_existent_file.txt";
        try (FileReader fileReader = new FileReader(filePath)) {
            fileReader.read();
        } catch (IOException exception) {
            System.err.println("Checked Exception Caught: File access failed.");
            System.err.println("Details: " + exception.getMessage());
        }
    }
}
