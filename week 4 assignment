import java.util.HashMap;
import java.util.Map;

public class Solution {
    public int subarraySum(int[] nums, int k) {
        int count = 0;
        int currentSum = 0;
        
        // Map to store frequency of prefix sums
        Map<Integer, Integer> prefixSumMap = new HashMap<>();
        
        // Base case: prefix sum of 0 has occurred once (for subarrays starting at index 0)
        prefixSumMap.put(0, 1);
        
        for (int num : nums) {
            currentSum += num; // Running prefix sum
            
            // If (currentSum - k) exists in map, add its frequency to total count
            if (prefixSumMap.containsKey(currentSum - k)) {
                count += prefixSumMap.get(currentSum - k);
            }
            
            // Record/update frequency of current prefix sum
            prefixSumMap.put(currentSum, prefixSumMap.getOrDefault(currentSum, 0) + 1);
        }
        
        return count;
    }
}

