public class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n = nums.length;
        int[] answer = new int[n];
        
        // Forward pass: calculate prefix products (product of elements to the left)
        answer[0] = 1;
        for (int i = 1; i < n; i++) {
            answer[i] = answer[i - 1] * nums[i - 1];
        }
        
        // Backward pass: multiply by suffix products (product of elements to the right)
        int rightRunningProduct = 1;
        for (int i = n - 1; i >= 0; i--) {
            answer[i] = answer[i] * rightRunningProduct;
            rightRunningProduct *= nums[i];
        }
        
        return answer;
    }
}

