public class Solution {
    public static int[] findTopThreeScores(int[] scores) {
        // Initialize running variables to track the top 3 highest scores
        int first = Integer.MIN_VALUE;
        int second = Integer.MIN_VALUE;
        int third = Integer.MIN_VALUE;

        // Single pass through the array from left to right
        for (int score : scores) {
            if (score > first) {
                // New highest score found: shift first and second down
                third = second;
                second = first;
                first = score;
            } else if (score > second) {
                // Beats second place: shift second down
                third = second;
                second = score;
            } else if (score > third) {
                // Beats third place
                third = score;
            }
        }

        // Return the three scores in descending order
        return new int[]{first, second, third};
    }

    public static void main(String[] args) {
        int[] scores = {45, 82, 79, 90, 33, 90, 61};
        int[] top3 = findTopThreeScores(scores);
        System.out.println(java.util.Arrays.toString(top3)); // Output: [90, 90, 82]
    }
}
