public class Solution {
    public static String findDuplicateTeam(String[] teamNames) {
        // Outer loop iterates through each team name
        for (int i = 0; i < teamNames.length; i++) {
            // Inner loop compares against subsequent names to avoid redundant checks
            for (int j = i + 1; j < teamNames.length; j++) {
                // Use .equals() for string value comparison
                if (teamNames[i].equals(teamNames[j])) {
                    return "Duplicate Found: " + teamNames[i];[cite: 12]
                }
            }
        }
        
        // Return clear message when no duplicates exist
        return "No Duplicates Found";[cite: 12]
    }

    public static void main(String[] args) {
        String[] test1 = {"ByteForce", "CodeCrafters", "ByteForce"};
        System.out.println(findDuplicateTeam(test1)); // Output: Duplicate Found: ByteForce

        String[] test2 = {"ByteForce", "CodeCrafters", "NullPointers"};
        System.out.println(findDuplicateTeam(test2)); // Output: No Duplicates Found[cite: 12]
    }
}

